rules_version = '2';

// Règles Firestore — Suivi de rentabilité des chantiers.
//
// Références CLAUDE.md : §2 (R2 modePrix figé, R4 chantierId == cid, R6 aucun
// delete physique, R11 quatre statuts), §5 (modèle), §9.2 (les invariants sont
// aussi validés côté client), §9.9 (versionnage bibliothèque), §9.10 (les
// transitions de statut ne sont PAS contraintes ici), §9.11 (storagePath d'un
// justificatif déplacé), §9.14 (périmètre : isolation par uid, pas de quotas,
// App Check à activer avant production).
//
// Les écritures client sont des set(merge: true) ou update() : dans les deux
// cas request.resource.data est l'état résultant complet du document, c'est lui
// qui est validé. createdAt / updatedAt sont des serverTimestamp, comparés à
// request.time. Les champs optionnels sont écrits explicitement à null
// (include_if_null) : `d.get('x', null)` accepte l'absence comme le null.
//
// Chaque document n'accepte que les clés de son entité Dart (`clesX()`) :
// toute nouvelle clé doit être ajoutée ici AVANT de déployer l'application
// (CLAUDE.md §10.7), sinon les écritures sont refusées (§9.2).
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers génériques
    // ------------------------------------------------------------------
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isTs(v) {
      return v is timestamp;
    }

    function isTsOpt(v) {
      return v == null || v is timestamp;
    }

    function isIntMin(v, min) {
      return v is int && v >= min;
    }

    function isIntRange(v, min, max) {
      return v is int && v >= min && v <= max;
    }

    function isIntOptMin(v, min) {
      return v == null || isIntMin(v, min);
    }

    function isNumMin(v, min) {
      return v is number && v >= min;
    }

    function isNumPos(v) {
      return v is number && v > 0;
    }

    function isNumOptMin(v, min) {
      return v == null || isNumMin(v, min);
    }

    function isStr(v) {
      return v is string;
    }

    function isStrNonVide(v) {
      return v is string && v.trim().size() > 0;
    }

    function isStrOpt(v) {
      return v == null || v is string;
    }

    function isBool(v) {
      return v is bool;
    }

    function isList(v) {
      return v is list;
    }

    function isMap(v) {
      return v is map;
    }

    function isEnum(v, valeurs) {
      return v is string && v in valeurs;
    }

    // Aucune clé hors de celles de l'entité (typo, données arbitraires).
    function clesAutorisees(d, cles) {
      return d.keys().hasOnly(cles);
    }

    // Clé absente, ou int >= min (jamais null).
    function absentOuIntMin(m, cle, min) {
      return !(cle in m) || isIntMin(m[cle], min);
    }

    // Champ identique avant / après (absent des deux côtés accepté).
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // Seuls les champs listés diffèrent entre l'état avant et l'état après.
    function seulsChampsModifies(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }

    // ------------------------------------------------------------------
    // Soft delete (R6) — FirestoreSubcollectionRepository.champsSoftDelete /
    // champsRestore : deletedAt = serverTimestamp | null explicite.
    // ------------------------------------------------------------------
    function softDeleteFields(d) {
      return isTsOpt(d.get('deletedAt', null))
        && isStrOpt(d.get('deletedReason', null))
        && (d.get('deletedAt', null) != null || d.get('deletedReason', null) == null);
    }

    // Création : le document naît actif, `deletedAt` présent à null (la
    // requête `where('deletedAt', isNull: true)` ne retient que les documents
    // où le champ existe).
    function creationActive() {
      return 'deletedAt' in request.resource.data
        && request.resource.data.deletedAt == null;
    }

    // Mise à jour : restauration (null), inchangé (upsert d'une entité relue)
    // ou suppression posée par le serveur (softDelete, deplacerVers).
    function deletedAtCoherent() {
      return request.resource.data.get('deletedAt', null) == null
        || unchanged('deletedAt')
        || request.resource.data.deletedAt == request.time;
    }

    // ------------------------------------------------------------------
    // Horodatage serveur (FirestoreCodec.toDoc)
    // ------------------------------------------------------------------
    function updatedAtServeur() {
      return request.resource.data.updatedAt == request.time;
    }

    // Création : createdAt et updatedAt posés par le serveur.
    function horodatageCreation() {
      return request.resource.data.createdAt == request.time && updatedAtServeur();
    }

    // Mise à jour : createdAt inchangé, ou re-posé par le serveur (le codec
    // remet un serverTimestamp quand l'entité écrite n'a pas de createdAt :
    // `Previsionnel.vide`, copie de `deplacerVers` sur un document existant).
    function horodatageMaj() {
      return isTs(request.resource.data.createdAt)
        && (unchanged('createdAt') || request.resource.data.createdAt == request.time)
        && updatedAtServeur();
    }

    // ------------------------------------------------------------------
    // Énumérations (core/constants/enums.dart — sérialisées par `name`)
    // ------------------------------------------------------------------
    function modesPrix() {
      return ['ht', 'ttc'];
    }

    // R11 : quatre statuts exactement.
    function statutsChantier() {
      return ['aFaireSigner', 'aVenir', 'enCours', 'termine'];
    }

    function typesDepense() {
      return ['materiaux', 'sousTraitance', 'repas', 'hotel', 'deplacement', 'autre'];
    }

    function statutsTravauxSup() {
      return ['propose', 'accepte', 'refuse'];
    }

    function statutsTache() {
      return ['aFaire', 'enCours', 'terminee'];
    }

    function domainesCategorie() {
      return ['depense', 'tache'];
    }

    function unites() {
      return ['m', 'm2', 'm3', 'u', 'forfait'];
    }

    function statutsUpload() {
      return ['pending', 'uploading', 'uploaded', 'failed'];
    }

    function mimesAutorises() {
      return ['image/jpeg', 'image/png', 'application/pdf'];
    }

    // Justificatif.extensionsParMime (nom de fichier `{id}.{ext}`).
    function extensionDe(mime) {
      return mime == 'image/jpeg' ? 'jpg' : (mime == 'image/png' ? 'png' : 'pdf');
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    function clesUtilisateur() {
      return ['email', 'createdAt', 'parametres'];
    }

    function clesParametres() {
      return ['modePrixParDefaut', 'seuilOrangePct', 'seuilRougePct',
        'seuilProjectionPct', 'baremeKmCents', 'effectifParDefaut',
        'minutesJourneeType', 'entrepriseNom', 'updatedAt'];
    }

    // ParametresUtilisateur (champ `parametres`, avec son propre updatedAt).
    function parametresValides(p) {
      return isMap(p)
        && clesAutorisees(p, clesParametres())
        && isEnum(p.modePrixParDefaut, modesPrix())
        && isNumMin(p.seuilOrangePct, 0)
        && isNumMin(p.seuilRougePct, 0)
        && p.seuilRougePct >= p.seuilOrangePct
        && isNumMin(p.seuilProjectionPct, 0)
        && p.seuilProjectionPct <= 100
        && isIntMin(p.baremeKmCents, 0)
        && isIntMin(p.effectifParDefaut, 1)
        && isIntRange(p.minutesJourneeType, 1, 1440)
        && isStr(p.entrepriseNom)
        && isTsOpt(p.get('updatedAt', null));
    }

    // email et createdAt sont posés par initialiserUtilisateur ; le document
    // peut aussi naître d'un premier `save` (parametres seuls, voir
    // auth_controller « le document sera créé au premier réglage »).
    function utilisateurValide(d) {
      return clesAutorisees(d, clesUtilisateur())
        && (!('email' in d) || isStr(d.email))
        && (!('createdAt' in d) || isTs(d.createdAt))
        && parametresValides(d.parametres);
    }

    function parametresHorodates() {
      return request.resource.data.parametres.updatedAt == request.time;
    }

    // Création : createdAt absent ou posé par le serveur.
    function createdAtUtilisateurCreation() {
      return !('createdAt' in request.resource.data)
        || request.resource.data.createdAt == request.time;
    }

    // Mise à jour : createdAt absent, inchangé, ou posé par le serveur s'il
    // n'existait pas encore.
    function createdAtUtilisateurMaj() {
      return !('createdAt' in request.resource.data)
        || unchanged('createdAt')
        || (resource.data.get('createdAt', null) == null
          && request.resource.data.createdAt == request.time);
    }

    // ------------------------------------------------------------------
    // users/{uid}/categories/{id}
    // ------------------------------------------------------------------
    function clesCategorie() {
      return ['libelle', 'domaine', 'ordre', 'actif', 'sousCategories',
        'createdAt', 'updatedAt'];
    }

    // sousCategories : liste de maps {id, libelle, ordre, actif} ; les
    // éléments ne sont pas validés un à un (pas de boucle dans les règles),
    // le client le fait (validerCategorie).
    function categorieValide(d) {
      return clesAutorisees(d, clesCategorie())
        && isStrNonVide(d.libelle)
        && isEnum(d.domaine, domainesCategorie())
        && isIntMin(d.ordre, 0)
        && isBool(d.actif)
        && isList(d.sousCategories);
    }

    // ------------------------------------------------------------------
    // users/{uid}/bibliothequeTaches/{id}
    // ------------------------------------------------------------------
    function clesTacheBibliotheque() {
      return ['libelle', 'categorieId', 'sousCategorieId', 'unite',
        'minutesParUnite', 'effectifDefaut', 'version', 'actif',
        'createdAt', 'updatedAt'];
    }

    function tacheBibliothequeValide(d) {
      return clesAutorisees(d, clesTacheBibliotheque())
        && isStrNonVide(d.libelle)
        && isStrOpt(d.get('categorieId', null))
        && isStrOpt(d.get('sousCategorieId', null))
        && isEnum(d.unite, unites())
        && isNumMin(d.minutesParUnite, 0)
        && isIntMin(d.effectifDefaut, 1)
        && isIntMin(d.version, 1)
        && isBool(d.actif);
    }

    // R5 / §9.9 : toute modification incrémente la version de 1
    // (modifierTache : set(merge) avec version + 1).
    function versionIncrementee() {
      return request.resource.data.version == resource.data.version + 1;
    }

    // Archivage / réactivation (archiverTache : update de actif seul) : la
    // version est conservée, seuls actif et updatedAt changent.
    function archivageSeul() {
      return request.resource.data.version == resource.data.version
        && seulsChampsModifies(['actif', 'updatedAt']);
    }

    // ------------------------------------------------------------------
    // users/{uid}/chantiers/{cid}
    // ------------------------------------------------------------------
    function clesChantier() {
      return ['nom', 'modePrix', 'statut', 'clientNom', 'clientTelephone',
        'adresse', 'prixVenduInitialCents', 'dateDevis', 'dateSignature',
        'dateDebutPrevue', 'dateFinPrevue', 'dateDebutReelle', 'dateFinReelle',
        'notes', 'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    function chantierValide(d) {
      return clesAutorisees(d, clesChantier())
        && isStrNonVide(d.nom)
        && isEnum(d.modePrix, modesPrix())
        && isEnum(d.statut, statutsChantier())
        && isStrOpt(d.get('clientNom', null))
        && isStrOpt(d.get('clientTelephone', null))
        && isStrOpt(d.get('adresse', null))
        && isIntMin(d.prixVenduInitialCents, 0)
        && isTsOpt(d.get('dateDevis', null))
        && isTsOpt(d.get('dateSignature', null))
        && isTsOpt(d.get('dateDebutPrevue', null))
        && isTsOpt(d.get('dateFinPrevue', null))
        && isTsOpt(d.get('dateDebutReelle', null))
        && isTsOpt(d.get('dateFinReelle', null))
        && isStrOpt(d.get('notes', null))
        && softDeleteFields(d);
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/previsionnel/main
    // ------------------------------------------------------------------
    function clesPrevisionnel() {
      return ['chantierId', 'budgetDepensesCents', 'budgetParTypeCents',
        'heuresPrevuesMinutes', 'heuresPersonnesPrevuesMinutes',
        'effectifPrevu', 'dureePrevueJours', 'commentaire',
        'createdAt', 'updatedAt'];
    }

    // budgetParTypeCents : clés = TypeDepense.name, valeurs int >= 0 (jamais
    // null : Map<String, int> côté client) ; la map vide est acceptée.
    function budgetParTypeValide(m) {
      return isMap(m)
        && m.keys().hasOnly(typesDepense())
        && absentOuIntMin(m, 'materiaux', 0)
        && absentOuIntMin(m, 'sousTraitance', 0)
        && absentOuIntMin(m, 'repas', 0)
        && absentOuIntMin(m, 'hotel', 0)
        && absentOuIntMin(m, 'deplacement', 0)
        && absentOuIntMin(m, 'autre', 0);
    }

    // chantierId est porté par le chemin (§5) : le client ne l'écrit pas ;
    // accepté seulement s'il vaut cid.
    function previsionnelValide(d, cid) {
      return clesAutorisees(d, clesPrevisionnel())
        && (!('chantierId' in d) || d.chantierId == cid)
        && isIntOptMin(d.get('budgetDepensesCents', null), 0)
        && (!('budgetParTypeCents' in d) || budgetParTypeValide(d.budgetParTypeCents))
        && isIntOptMin(d.get('heuresPrevuesMinutes', null), 0)
        && isIntOptMin(d.get('heuresPersonnesPrevuesMinutes', null), 0)
        && isIntOptMin(d.get('effectifPrevu', null), 1)
        && isIntOptMin(d.get('dureePrevueJours', null), 0)
        && isStrOpt(d.get('commentaire', null));
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/taches/{id}
    // ------------------------------------------------------------------
    function clesTache() {
      return ['chantierId', 'libelle', 'categorieId', 'sousCategorieId',
        'bibliothequeTacheId', 'bibliothequeVersion', 'unite',
        'quantitePrevue', 'minutesParUniteSnapshot', 'effectifDefautSnapshot',
        'heuresPrevuesMinutes', 'effectifPrevu', 'travauxSupId', 'statut',
        'ordre', 'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    function tacheValide(d, cid) {
      return clesAutorisees(d, clesTache())
        && d.chantierId == cid
        && isStrNonVide(d.libelle)
        && isStrOpt(d.get('categorieId', null))
        && isStrOpt(d.get('sousCategorieId', null))
        && isStrOpt(d.get('bibliothequeTacheId', null))
        && isIntOptMin(d.get('bibliothequeVersion', null), 1)
        && isEnum(d.unite, unites())
        && isNumPos(d.quantitePrevue)
        && isNumOptMin(d.get('minutesParUniteSnapshot', null), 0)
        && isIntOptMin(d.get('effectifDefautSnapshot', null), 1)
        && isIntOptMin(d.get('heuresPrevuesMinutes', null), 0)
        && isIntOptMin(d.get('effectifPrevu', null), 1)
        && isStrOpt(d.get('travauxSupId', null))
        && isEnum(d.statut, statutsTache())
        && isIntMin(d.ordre, 0)
        && softDeleteFields(d);
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/depenses/{id}
    // ------------------------------------------------------------------
    function clesDepense() {
      return ['chantierId', 'date', 'type', 'montantCents', 'libelle',
        'fournisseur', 'categorieId', 'sousCategorieId', 'tacheId',
        'travauxSupId', 'justificatifIds', 'distanceKm',
        'baremeKmCentsSnapshot', 'montantSaisiManuellement', 'commentaire',
        'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    // R4 : une dépense appartient toujours à un chantier (chantierId == cid).
    // justificatifIds : liste (vide acceptée) d'ids ; éléments non validés
    // un à un (pas de boucle dans les règles).
    function depenseValide(d, cid) {
      return clesAutorisees(d, clesDepense())
        && d.chantierId == cid
        && isEnum(d.type, typesDepense())
        && isIntMin(d.montantCents, 0)
        && isTs(d.date)
        && isStrOpt(d.get('libelle', null))
        && isStrOpt(d.get('fournisseur', null))
        && isStrOpt(d.get('categorieId', null))
        && isStrOpt(d.get('sousCategorieId', null))
        && isStrOpt(d.get('tacheId', null))
        && isStrOpt(d.get('travauxSupId', null))
        && isList(d.justificatifIds)
        && isNumOptMin(d.get('distanceKm', null), 0)
        && isIntOptMin(d.get('baremeKmCentsSnapshot', null), 0)
        && isBool(d.montantSaisiManuellement)
        && isStrOpt(d.get('commentaire', null))
        && softDeleteFields(d);
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/heures/{id}
    // ------------------------------------------------------------------
    function clesSaisieHeures() {
      return ['chantierId', 'date', 'tacheId', 'tacheLibelleSnapshot',
        'travauxSupId', 'nbPersonnes', 'minutesParPersonne', 'commentaire',
        'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    function saisieHeuresValide(d, cid) {
      return clesAutorisees(d, clesSaisieHeures())
        && d.chantierId == cid
        && isTs(d.date)
        && isStrOpt(d.get('tacheId', null))
        && isStrOpt(d.get('tacheLibelleSnapshot', null))
        && isStrOpt(d.get('travauxSupId', null))
        && isIntMin(d.nbPersonnes, 1)
        && isIntRange(d.minutesParPersonne, 0, 1440)
        && isStrOpt(d.get('commentaire', null))
        && softDeleteFields(d);
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/travauxSup/{id}
    // ------------------------------------------------------------------
    function clesTravauxSup() {
      return ['chantierId', 'libelle', 'dateProposition', 'description',
        'statut', 'prixVenduCents', 'budgetDepensesCents',
        'heuresPrevuesMinutes', 'effectifPrevu', 'dateDecision',
        'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    function travauxSupValide(d, cid) {
      return clesAutorisees(d, clesTravauxSup())
        && d.chantierId == cid
        && isStrNonVide(d.libelle)
        && isStrOpt(d.get('description', null))
        && isEnum(d.statut, statutsTravauxSup())
        && isIntMin(d.prixVenduCents, 0)
        && isIntOptMin(d.get('budgetDepensesCents', null), 0)
        && isIntOptMin(d.get('heuresPrevuesMinutes', null), 0)
        && isIntOptMin(d.get('effectifPrevu', null), 1)
        && isTs(d.dateProposition)
        && isTsOpt(d.get('dateDecision', null))
        && softDeleteFields(d);
    }

    // ------------------------------------------------------------------
    // chantiers/{cid}/justificatifs/{id}
    // ------------------------------------------------------------------
    function clesJustificatif() {
      return ['chantierId', 'depenseId', 'storagePath', 'uploadStatus',
        'mimeType', 'sizeBytes', 'takenAt',
        'createdAt', 'updatedAt', 'deletedAt', 'deletedReason'];
    }

    // storagePath = users/{uid}/chantiers/{cidFichier}/justificatifs/{id}.{ext}
    // (FirestorePaths.storageJustificatif). Après `deplacerVers` (§9.11) le
    // fichier reste sous le chantier d'origine : cidFichier n'est donc pas
    // contraint à cid, mais le chemin reste sous l'uid du propriétaire et le
    // nom de fichier est celui du justificatif (Justificatif.nomFichier).
    function cheminStorageValide(chemin, uid, id, mime) {
      let parts = chemin.split('/');
      return parts.size() == 6
        && parts[0] == 'users'
        && parts[1] == uid
        && parts[2] == 'chantiers'
        && parts[3].size() > 0
        && parts[4] == 'justificatifs'
        && parts[5] == id + '.' + extensionDe(mime);
    }

    function justificatifValide(d, uid, cid, id) {
      return clesAutorisees(d, clesJustificatif())
        && d.chantierId == cid
        && isStrOpt(d.get('depenseId', null))
        && isEnum(d.uploadStatus, statutsUpload())
        && isEnum(d.mimeType, mimesAutorises())
        && isIntRange(d.sizeBytes, 0, 10485760)
        && isStrOpt(d.get('storagePath', null))
        && (d.get('storagePath', null) == null
          || cheminStorageValide(d.storagePath, uid, id, d.mimeType))
        && isTsOpt(d.get('takenAt', null))
        && softDeleteFields(d);
    }

    // ==================================================================
    // Matches — isolation par uid, aucun delete physique (R6).
    // Aucune règle `match /{path=**}/…` : les requêtes collectionGroup sont
    // refusées (le client n'en fait pas).
    // ==================================================================
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && utilisateurValide(request.resource.data)
        && createdAtUtilisateurCreation()
        && parametresHorodates();
      allow update: if isOwner(uid)
        && utilisateurValide(request.resource.data)
        && createdAtUtilisateurMaj()
        && (unchanged('parametres') || parametresHorodates());
      allow delete: if false;

      match /categories/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && categorieValide(request.resource.data)
          && horodatageCreation();
        allow update: if isOwner(uid)
          && categorieValide(request.resource.data)
          && horodatageMaj();
        allow delete: if false;
      }

      match /bibliothequeTaches/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && tacheBibliothequeValide(request.resource.data)
          && request.resource.data.version == 1
          && horodatageCreation();
        allow update: if isOwner(uid)
          && tacheBibliothequeValide(request.resource.data)
          && horodatageMaj()
          && (versionIncrementee() || archivageSeul());
        allow delete: if false;
      }

      match /chantiers/{cid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && chantierValide(request.resource.data)
          && creationActive()
          && horodatageCreation();
        // R2 : modePrix figé à la création.
        allow update: if isOwner(uid)
          && chantierValide(request.resource.data)
          && unchanged('modePrix')
          && deletedAtCoherent()
          && horodatageMaj();
        allow delete: if false;

        match /previsionnel/{docId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && docId == 'main'
            && previsionnelValide(request.resource.data, cid)
            && horodatageCreation();
          allow update: if isOwner(uid)
            && docId == 'main'
            && previsionnelValide(request.resource.data, cid)
            && horodatageMaj();
          allow delete: if false;
        }

        match /taches/{id} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && tacheValide(request.resource.data, cid)
            && creationActive()
            && horodatageCreation();
          allow update: if isOwner(uid)
            && tacheValide(request.resource.data, cid)
            && deletedAtCoherent()
            && horodatageMaj();
          allow delete: if false;
        }

        match /depenses/{id} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && depenseValide(request.resource.data, cid)
            && creationActive()
            && horodatageCreation();
          allow update: if isOwner(uid)
            && depenseValide(request.resource.data, cid)
            && deletedAtCoherent()
            && horodatageMaj();
          allow delete: if false;
        }

        match /heures/{id} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && saisieHeuresValide(request.resource.data, cid)
            && creationActive()
            && horodatageCreation();
          allow update: if isOwner(uid)
            && saisieHeuresValide(request.resource.data, cid)
            && deletedAtCoherent()
            && horodatageMaj();
          allow delete: if false;
        }

        match /travauxSup/{id} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && travauxSupValide(request.resource.data, cid)
            && creationActive()
            && horodatageCreation();
          allow update: if isOwner(uid)
            && travauxSupValide(request.resource.data, cid)
            && deletedAtCoherent()
            && horodatageMaj();
          allow delete: if false;
        }

        match /justificatifs/{id} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && justificatifValide(request.resource.data, uid, cid, id)
            && creationActive()
            && horodatageCreation();
          allow update: if isOwner(uid)
            && justificatifValide(request.resource.data, uid, cid, id)
            && deletedAtCoherent()
            && horodatageMaj();
          allow delete: if false;
        }
      }
    }

    // Tout autre chemin est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
