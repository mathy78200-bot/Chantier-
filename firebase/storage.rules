rules_version = '2';

// Règles Storage — justificatifs (CLAUDE.md §5, §9.6, §9.11).
//
// Chemin : users/{uid}/chantiers/{cid}/justificatifs/{id}.{jpg|png|pdf}
// (FirestorePaths.storageJustificatif, JustificatifStorage.upload).
// - lecture / écriture réservées au propriétaire (uid) ;
// - JPEG, PNG ou PDF uniquement, extension cohérente avec le contentType
//   (Justificatif.extensionsParMime), fichier non vide, 10 Mo maximum
//   (compresser avant envoi, §9.6) ;
// - `update` autorisé (nouvel envoi au même chemin après un échec) ;
// - aucune suppression ni déplacement (R6, §9.11) ;
// - tout autre chemin refusé (aucune liste hors du dossier du propriétaire).
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Extension du nom de fichier cohérente avec le type MIME envoyé.
    function extensionCoherente(file) {
      return (file.matches('^.+[.]jpg$') && request.resource.contentType == 'image/jpeg')
        || (file.matches('^.+[.]png$') && request.resource.contentType == 'image/png')
        || (file.matches('^.+[.]pdf$') && request.resource.contentType == 'application/pdf');
    }

    function fichierAutorise(file) {
      return request.resource.size > 0
        && request.resource.size <= 10485760
        && extensionCoherente(file);
    }

    match /users/{uid}/chantiers/{cid}/justificatifs/{file} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && fichierAutorise(file);
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
