rules_version = '2';

// Règles Storage — justificatifs (CLAUDE.md §5, §9.6, §9.11).
//
// Chemin : users/{uid}/chantiers/{cid}/justificatifs/{id}.{jpg|png|pdf}.
// - lecture / écriture réservées au propriétaire (uid) ;
// - JPEG, PNG ou PDF uniquement, 10 Mo maximum (compresser avant envoi, §9.6) ;
// - aucune suppression ni déplacement (R6, §9.11) ;
// - tout autre chemin refusé.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function fichierAutorise() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.size <= 10485760;
    }

    match /users/{uid}/chantiers/{cid}/justificatifs/{file} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && fichierAutorise();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
